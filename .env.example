# Required in production (and for `astro preview` / `npm start`).
# Random string, at least 16 characters (32+ recommended).
# Example: openssl rand -base64 32
AUTH_SECRET=

# Optional. Directory for the first-party email/password user store (JSON).
# AUTH_DATA_DIR=.data

# Optional. Session cookies are Secure in production builds.
# Set false for local `astro preview` / `npm start` over HTTP.
# AUTH_COOKIE_SECURE=false
