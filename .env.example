# AUTH_SECRET is required in production (and for `astro preview` / `npm start`).
# Random string, at least 16 characters (32+ recommended).
# Example: openssl rand -base64 32
#
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are optional Google OAuth
# (OAuth 2.0 Web client in Google Cloud Console). When unset,
# "Continue with Google" shows: Couldn’t connect to Google. Try email or try again.
# Email + password still works.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Authorized redirect URI must match Google Cloud Console exactly.
GOOGLE_CALLBACK_URL=http://localhost:4321/auth/google/callback

# Optional. Directory for the first-party JSON store (users, onboarding, plans, sessions,
# feedback, AdaptationEvents). Used by the web app and `npm run adapt`.
# AUTH_DATA_DIR=.data

# Optional. Session cookies are Secure in production builds.
# Set false for local `astro preview` / `npm start` over HTTP.
# AUTH_COOKIE_SECURE=false

# Required for HTTP POST/GET /api/adapt (cron). The CLI `npm run adapt` does not need this.
# Random string, at least 16 characters recommended.
# ADAPT_CRON_SECRET=

# Optional nocturnal adaptation LLM (OpenAI-compatible). Unset = heuristic MVP
# (still only runs when Feedback exists that Guayaquil day).
# If set and the call fails: log, do not mutate the plan, retry next run.
# ADAPT_LLM_API_KEY=
# ADAPT_LLM_BASE_URL=https://api.openai.com/v1
# ADAPT_LLM_MODEL=gpt-4o-mini
