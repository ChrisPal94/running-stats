# AUTH_SECRET is required in production (and for `astro preview` / `npm start`).
# Random string, at least 16 characters (32+ recommended).
# Example: openssl rand -base64 32
AUTH_SECRET=

# Session cookies are Secure in production builds (default true when unset).
# Local `astro preview` / `npm start` over HTTP: false
# Railway HTTPS: true (or leave empty)
AUTH_COOKIE_SECURE=

# Directory for the first-party SQLite database (`app.db`: users, onboarding,
# plans, sessions, feedback, RunLogs, AdaptationEvents, Intervals connection
# status, magic link tokens). Used by the web app and `npm run adapt`. Railway: mount the volume
# at `.data` (see DEPLOY.md). Legacy `users.json` / `training.json` in this
# directory are imported once if the database is empty, then SQLite is the
# source of truth. The Intervals API key is never stored in this database.
AUTH_DATA_DIR=.data

# Google OAuth (optional). OAuth 2.0 Web client in Google Cloud Console.
# When unset, "Continue with Google" shows: Couldn’t connect to Google. Try email or try again.
# Email + password still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Authorized redirect URI must match Google Cloud Console exactly.
# Local: http://localhost:4321/auth/google/callback
# Production: https://<your-public-host>/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4321/auth/google/callback

# Magic link email (optional). Resend HTTP API.
# When RESEND_API_KEY and MAIL_FROM are set, /login and /signup Email link sends
# "Your Stride Lab sign-in link". The Sign in button goes to /auth/magic?token=…
# (15 min, one-time). In local/dev (NODE_ENV !== production), if mail is unset the
# full sign-in URL is logged server-side and the UI still shows “Check your email”.
# In production, unset mail fails with “Couldn’t send the link. Try again.” and
# never logs the token or link.
RESEND_API_KEY=
MAIL_FROM=
# One-release fallback if MAIL_FROM is unset (prefer MAIL_FROM).
MAGIC_LINK_FROM=

# Required for HTTP POST/GET /api/adapt (Railway cron). The CLI `npm run adapt` does not need this.
# Random string, at least 16 characters recommended.
ADAPT_CRON_SECRET=

# Optional LLM (OpenAI-compatible). Shared by the nightly adapt job and
# Today → Generate feedback. Unset key: adapt stays on the heuristic, and
# Generate feedback tells the athlete to try again later (the UI never names
# these variables).
# If the key is set and the adapt call fails: log, do not mutate the plan, retry next run.
ADAPT_LLM_API_KEY=
ADAPT_LLM_BASE_URL=https://api.openai.com/v1
ADAPT_LLM_MODEL=gpt-4o-mini
# One-release fallback if ADAPT_LLM_API_KEY is unset (prefer ADAPT_LLM_API_KEY).
# Ignores ADAPT_LLM_BASE_URL and ADAPT_LLM_MODEL (this file ships the OpenAI
# host and model). Host is https://ollama.com/v1. Model is OLLAMA_MODEL
# (default gemma4:31b).
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b

# Intervals.icu import (optional). Required to Connect from Settings → Connected apps.
# Basic auth: username `API_KEY`, password = this key. Never stored in SQLite or shown in the UI.
# HTTP calls send User-Agent `RunningStatsMVP/0.1` and use athlete path `0` (athlete of the key).
INTERVALS_ICU_API_KEY=

# Display id for Connected · {id} if the API does not return one. Default Christian `i704884`.
# Not used in HTTP paths (those are `0`).
INTERVALS_ICU_ATHLETE_ID=i704884

# Emails allowed to use the shared Intervals.icu key above. Comma-separated.
# Case-insensitive; whitespace around each address is ignored.
# Unset or empty: nobody can Connect, sync, or read Intervals data (fail closed).
# The account must also have a verified email (Google with email_verified, or a
# consumed magic link). Password signup does not verify. Existing rows are not
# backfilled, so after deploy Intervals stays unavailable until the owner signs
# in once with Google or a magic link.
# Production must set this to the key owner:
# INTERVALS_OWNER_EMAILS=crispal94@gmail.com
INTERVALS_OWNER_EMAILS=
