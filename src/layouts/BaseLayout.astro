---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Running Stats — Know today's run",
  description = "A training plan that adapts after every run—so you always know what to run next, and why.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05090b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
