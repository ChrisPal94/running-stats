---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Running Stats — Know what to run today",
  description = "A coach AI that answers what you should run today and adapts your plan when life gets in the way.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05090b" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
