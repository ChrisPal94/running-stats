---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  eyebrow?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  heading,
  eyebrow = "Coach AI",
  noindex = false,
} = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="relative isolate min-h-svh bg-ink">
    <Header />
    <main class="mx-auto w-full max-w-3xl px-5 pb-16 pt-6 sm:px-8 sm:pt-8 lg:px-12">
      <p class="text-[0.66rem] font-semibold tracking-[0.13em] text-lime uppercase">
        {eyebrow}
      </p>
      <h1
        class="mt-3 max-w-[16ch] text-[clamp(2rem,6vw,3.5rem)] leading-[0.9] font-bold tracking-[-0.04em] text-cloud uppercase"
      >
        {heading}
      </h1>
      <div class="mt-8 flex flex-col gap-5 text-sm leading-6 text-[#d6ded6] sm:text-base">
        <slot />
      </div>
    </main>
  </div>
</BaseLayout>
