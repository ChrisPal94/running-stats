---
import BaseLayout from "./BaseLayout.astro";
import BrandLogo from "../components/BrandLogo.astro";
import BottomNav from "../components/BottomNav.astro";

interface Props {
  title: string;
  description: string;
  current: "today" | "plan" | "progress" | "settings";
  email: string;
}

const { title, description, current, email } = Astro.props;
---

<BaseLayout title={title} description={description} noindex>
  <div class="relative isolate min-h-svh bg-ink">
    <header class="px-5 pt-4 sm:px-8">
      <div class="mx-auto flex max-w-md items-center justify-between">
        <BrandLogo href="/today" label="Stride Lab — Today" />
      </div>
    </header>
    <main
      class="mx-auto w-full max-w-md px-5 pb-[calc(6.25rem+env(safe-area-inset-bottom))] pt-5 sm:px-8"
    >
      <slot />
    </main>
    <BottomNav current={current} email={email} />
  </div>
</BaseLayout>
