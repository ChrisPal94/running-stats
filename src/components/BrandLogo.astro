---
import { Image } from "astro:assets";
import logoRunner from "../assets/brand/logo-runner.png";
import logoWordmark from "../assets/brand/logo-wordmark.png";

interface Props {
  href?: string;
  label?: string;
  class?: string;
}

const { href, label = "Stride Lab home", class: className } = Astro.props;
const classes = ["group flex items-center gap-2", className];
const densities = [1, 2, 3];
const runnerSize = { width: 47, height: 40 };
const wordmarkSize = { width: 89, height: 36 };
---

{
  href ? (
    <a class:list={classes} href={href} aria-label={label}>
      <Image
        src={logoRunner}
        alt=""
        aria-hidden="true"
        loading="eager"
        width={runnerSize.width}
        height={runnerSize.height}
        densities={densities}
        class="h-10 w-auto transition-transform duration-300 ease-out group-hover:-rotate-6"
      />
      <Image
        src={logoWordmark}
        alt=""
        aria-hidden="true"
        loading="eager"
        width={wordmarkSize.width}
        height={wordmarkSize.height}
        densities={densities}
        class="h-9 w-auto"
      />
    </a>
  ) : (
    <div class:list={classes}>
      <Image
        src={logoRunner}
        alt=""
        aria-hidden="true"
        loading="eager"
        width={runnerSize.width}
        height={runnerSize.height}
        densities={densities}
        class="h-10 w-auto transition-transform duration-300 ease-out group-hover:-rotate-6"
      />
      <Image
        src={logoWordmark}
        alt=""
        aria-hidden="true"
        loading="eager"
        width={wordmarkSize.width}
        height={wordmarkSize.height}
        densities={densities}
        class="h-9 w-auto"
      />
    </div>
  )
}
