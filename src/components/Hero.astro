---
import { Image } from "astro:assets";
import heroBackground from "../assets/hero-background.jpg";
import ActivitySummary from "./ActivitySummary.astro";
import Header from "./Header.astro";
import RunStatCard from "./RunStatCard.astro";
import SocialProof from "./SocialProof.astro";
---

<div id="top" class="hero-stage relative isolate min-h-svh overflow-hidden bg-ink">
  <Image
    src={heroBackground}
    alt=""
    aria-hidden="true"
    widths={[768, 1280, 1600, 2048]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-30 h-full w-full object-cover object-center"
  />
  <div
    class="absolute inset-0 -z-20 bg-[linear-gradient(90deg,rgba(5,9,11,0.05)_0%,rgba(5,9,11,0.02)_54%,rgba(5,9,11,0.18)_100%)]"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-[45%] bg-[linear-gradient(180deg,transparent,rgba(5,9,11,0.82))]"
    aria-hidden="true"
  ></div>

  <Header />

  <div
    class="mx-auto grid w-full max-w-[1600px] gap-x-10 gap-y-8 px-5 pb-7 sm:px-8 sm:pb-9 lg:min-h-[calc(100svh-104px)] lg:grid-cols-[minmax(0,1.35fr)_minmax(21rem,0.65fr)] lg:grid-rows-[1fr_auto] lg:px-12 lg:pb-10 xl:gap-x-16"
  >
    <section class="flex flex-col justify-center pt-12 sm:pt-18 lg:pt-2" aria-labelledby="hero-title">
      <h1
        id="hero-title"
        class="max-w-[12ch] text-[clamp(3.25rem,8.5vw,6rem)] leading-[0.82] font-bold tracking-[-0.04em] text-cloud uppercase"
      >
        Know
        <span class="mt-3 flex items-center gap-[0.16em] whitespace-nowrap">
          <span class="accent-mark" aria-hidden="true">//</span>
          <span>Today's run</span>
        </span>
        <span class="block text-lime">Own the plan</span>
      </h1>

      <div class="mt-8 flex max-w-xl flex-col gap-6">
        <p class="max-w-[35rem] text-sm leading-6 text-[#d6ded6] sm:text-base">
          A training plan that adapts after every run—so you always know what to run next, and why.
        </p>
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
          <a
            href="/signup"
            class="inline-flex shrink-0 items-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)]"
          >
            Start your plan
          </a>
          <a
            href="#how"
            class="group inline-flex shrink-0 items-center gap-3 border-b border-lime pb-2 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
          >
            See how it works
            <svg
              class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <div class="flex items-center lg:justify-end lg:pt-8">
      <ActivitySummary />
    </div>

    <div class="grid gap-6 sm:grid-cols-[minmax(17rem,22rem)_1fr] sm:items-end lg:col-span-2 lg:grid-cols-[22rem_1fr]">
      <RunStatCard />
      <SocialProof />
    </div>
  </div>
</div>

<style>
  .accent-mark {
    color: var(--color-lime);
    display: inline-block;
    font-size: 0.86em;
    letter-spacing: -0.24em;
    margin-right: 0.08em;
    transform: skewX(-12deg);
  }

  @media (max-width: 1023px) {
    .hero-stage :global(img) {
      object-position: 58% center;
    }
  }

  @media (max-width: 639px) {
    .hero-stage :global(img) {
      object-position: 54% center;
    }
  }
</style>
