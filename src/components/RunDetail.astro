---
import RunChart from "./RunChart.astro";
import { chartGeometry, detailForRun, type RunDetail } from "../lib/run-detail";
import { formatPace, type RunLog } from "../lib/training";

interface Props {
  runLog: RunLog;
}

const { runLog } = Astro.props;
const route = runLog.route ?? { type: "none" as const };
const coords = route.type === "polyline" ? route.coords : [];
const detail: RunDetail = detailForRun(coords, route.samples, runLog.timeSec);
const paceChart = chartGeometry(detail.series.paceSecPerKm, 320, 112, true);
const hrChart = chartGeometry(detail.series.heartrate, 320, 112, false);
const cadenceChart = chartGeometry(detail.series.stepRateSpm, 320, 112, false);
const fastestPace = detail.splits.reduce<number | null>((best, split) => {
  if (split.distanceKm < 0.95) return best;
  return best === null || split.paceSecPerKm < best ? split.paceSecPerKm : best;
}, null);

const facts = [
  detail.avgHr !== null ? { label: "Avg HR", value: String(detail.avgHr) } : null,
  detail.maxHr !== null ? { label: "Max HR", value: String(detail.maxHr) } : null,
  detail.avgStepRate !== null ? { label: "Steps", value: String(detail.avgStepRate) } : null,
  detail.elevationGainM !== null ? { label: "Gain", value: `${detail.elevationGainM} m` } : null,
].filter((fact): fact is { label: string; value: string } => Boolean(fact));
---

<div class="mt-5 flex flex-col gap-6 border-t border-white/10 pt-5">
  {
    facts.length > 0 && (
      <dl class="grid grid-cols-4 divide-x divide-white/10">
        {facts.map((fact) => (
          <div class="px-2 first:pl-0 last:pr-0">
            <dt class="text-[0.58rem] tracking-wider text-mist uppercase">{fact.label}</dt>
            <dd class="mt-1 text-sm font-semibold text-cloud tabular-nums">{fact.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <RunChart
    title="Pace"
    titleId="run-pace-title"
    chart={paceChart}
    top={paceChart ? formatPace(paceChart.min) : ""}
    bottom={paceChart ? formatPace(paceChart.max) : ""}
    stroke="text-lime"
    empty="Pace was not in this run."
    label="Pace along the run. Faster is higher."
  />
  <RunChart
    title="Heart rate"
    titleId="run-hr-title"
    chart={hrChart}
    top={hrChart ? String(Math.round(hrChart.max)) : ""}
    bottom={hrChart ? String(Math.round(hrChart.min)) : ""}
    stroke="text-cloud"
    empty="Heart rate was not in this run."
    label="Heart rate along the run"
  />
  <RunChart
    title="Cadence"
    titleId="run-cadence-title"
    chart={cadenceChart}
    top={cadenceChart ? String(Math.round(cadenceChart.max)) : ""}
    bottom={cadenceChart ? String(Math.round(cadenceChart.min)) : ""}
    stroke="text-cloud"
    empty="Cadence was not in this run."
    label="Step rate along the run"
  />

  {
    detail.splits.length > 0 && (
      <section aria-labelledby="run-splits-title">
        <h3 id="run-splits-title" class="text-sm font-semibold text-cloud">
          Splits
        </h3>
        <table class="mt-3 w-full text-left text-sm">
          <thead>
            <tr class="text-[0.58rem] tracking-wider text-mist uppercase">
              <th class="py-2 font-semibold" scope="col">Km</th>
              <th class="py-2 font-semibold" scope="col">Pace</th>
              <th class="py-2 font-semibold" scope="col">HR</th>
              <th class="py-2 text-right font-semibold" scope="col">Steps</th>
            </tr>
          </thead>
          <tbody>
            {detail.splits.map((split) => {
              const fastest = fastestPace !== null && split.distanceKm >= 0.95 && split.paceSecPerKm === fastestPace;
              return (
                <tr class:list={["border-t border-white/10 tabular-nums", fastest && "text-lime"]}>
                  <th class="py-2.5 font-semibold" scope="row">{split.label}</th>
                  <td class="py-2.5">{formatPace(split.paceSecPerKm)}</td>
                  <td class="py-2.5">{split.heartrate ?? "—"}</td>
                  <td class="py-2.5 text-right">{split.stepRateSpm ?? "—"}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </section>
    )
  }
</div>
