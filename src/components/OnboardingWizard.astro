---
import {
  DEFAULT_DAYS,
  GOALS,
  LEVELS,
  MIN_TRAINING_DAYS,
  RACE_DISTANCES,
  WEEKDAYS,
  formatHms,
  formatPace,
  isBaseline,
  isPaceSoftOutOfRange,
  raceDistanceIdFromKm,
  type OnboardingRecord,
  type OnboardingStep,
} from "../lib/training";
import { appTodayYmd } from "../lib/calendar";

interface Props {
  step: OnboardingStep;
  error?: string;
  draft: OnboardingRecord | null;
}

const { step, error = "", draft } = Astro.props;
const today = appTodayYmd();
const selectedDays = draft?.days?.length ? draft.days : DEFAULT_DAYS;
const raceDate = draft?.raceDate ?? "";
const baseline = isBaseline(draft?.baseline) ? draft.baseline : null;
const selectedKind = baseline?.kind ?? "last-race";
const lastRace = baseline?.kind === "last-race" ? baseline : null;
const cooper = baseline?.kind === "cooper" ? baseline : null;
const lastRaceDistance = lastRace ? raceDistanceIdFromKm(lastRace.distanceKm) : "5k";
const lastRaceTime = lastRace ? formatHms(lastRace.timeSec) : "";
const lastRaceCustomKm = lastRaceDistance === "custom" && lastRace ? String(lastRace.distanceKm) : "";
const lastRaceDate = lastRace?.date ?? "";
const lastRacePace = lastRace ? formatPace(lastRace.paceSecPerKm) : "";
const showPaceWarning = lastRace ? isPaceSoftOutOfRange(lastRace.paceSecPerKm) : false;
const cooperDistance = cooper ? String(cooper.distanceKm) : "";

const headings = {
  1: { title: "Your goal", sub: "What are you training for?" },
  2: { title: "Your level", sub: "We’ll scale the first plan to this." },
  3: { title: "Your baseline", sub: "How fit are you right now?" },
  4: { title: "Your days", sub: "Pick at least three days you can run." },
} as const;

const heading = headings[step];
const steps = [1, 2, 3, 4] as const;
const kindToggleClass =
  "flex min-h-11 flex-1 cursor-pointer items-center justify-center rounded-full border border-white/12 px-1.5 py-2 text-center text-[0.62rem] font-semibold leading-tight text-mist uppercase transition-colors has-[:checked]:border-lime has-[:checked]:bg-lime has-[:checked]:text-ink";
const chipClass =
  "cursor-pointer rounded-2xl border border-white/12 bg-panel px-3 py-3 text-center text-sm font-semibold text-cloud transition-colors hover:border-lime/50 hover:bg-white/[0.04] has-[:checked]:border-lime has-[:checked]:bg-lime has-[:checked]:text-ink";
---

<div class="flex max-w-md flex-col gap-5">
  <div>
    <p class="text-[0.66rem] font-semibold tracking-[0.13em] text-lime uppercase">{step} / 4</p>
    <div class="mt-3 flex gap-1.5" aria-hidden="true">
      {
        steps.map((index) => (
          <span
            class:list={[
              "h-1 flex-1 rounded-full",
              index <= step ? "bg-lime" : "bg-white/12",
            ]}
          />
        ))
      }
    </div>
    <p class="sr-only">Step {step} of 4</p>
  </div>

  <div>
    <h1
      class="max-w-[16ch] text-[clamp(1.85rem,6vw,3rem)] leading-[0.9] font-bold tracking-[-0.04em] text-cloud uppercase"
    >
      {heading.title}
    </h1>
    <p class="mt-3 text-sm leading-6 text-[#d6ded6]">{heading.sub}</p>
  </div>

  {
    error && (
      <p
        class="rounded-xl border border-[#ff8a80]/30 bg-[#ff8a80]/8 px-4 py-3 text-sm leading-6 text-[#ffb4aa]"
        role="alert"
      >
        {error}
      </p>
    )
  }

  {
    step === 1 && (
      <form method="post" class="flex flex-col gap-4">
        <label class="flex flex-col gap-2">
          <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
            Race date <span class="normal-case tracking-normal text-mist/80">(optional)</span>
          </span>
          <input
            type="date"
            name="raceDate"
            value={raceDate ?? ""}
            min={today}
            class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
          />
        </label>
        <p class="text-xs leading-5 text-mist">
          Skip if you don’t have a race. Not needed for Just consistent.
        </p>
        <div class="grid grid-cols-2 gap-2">
          {GOALS.map((goal) => (
            <button
              type="submit"
              name="goal"
              value={goal.id}
              class:list={[
                "rounded-2xl border border-white/12 bg-panel px-4 py-3.5 text-sm font-semibold text-cloud transition-colors hover:border-lime/50 hover:bg-white/[0.04]",
                goal.id === "consistent" && "col-span-2",
              ]}
            >
              {goal.label}
            </button>
          ))}
        </div>
      </form>
    )
  }

  {
    step === 2 && (
      <form method="post" class="flex flex-col gap-2">
        {LEVELS.map((level) => (
          <button
            type="submit"
            name="level"
            value={level.id}
            class="rounded-2xl border border-white/12 bg-panel px-4 py-3.5 text-left transition-colors hover:border-lime/50 hover:bg-white/[0.04]"
          >
            <span class="block text-sm font-semibold text-cloud">{level.label}</span>
            <span class="mt-1 block text-xs leading-5 font-normal text-mist">{level.help}</span>
          </button>
        ))}
        <p class="pt-2">
          <a
            href="/onboarding?step=1"
            class="inline-flex items-center gap-2 border-b border-lime pb-1 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
          >
            Back
          </a>
        </p>
      </form>
    )
  }

  {
    step === 3 && (
      <form method="post" class="flex flex-col gap-5" data-baseline-form>
        <input type="hidden" name="intent" value="baseline" />
        <fieldset>
          <legend class="sr-only">How fit are you right now?</legend>
          <div class="flex gap-1.5" role="radiogroup" aria-label="Baseline type">
            <label class={kindToggleClass}>
              <input
                class="sr-only"
                type="radio"
                name="baselineKind"
                value="last-race"
                checked={selectedKind === "last-race"}
                data-baseline-kind
              />
              Last race
            </label>
            <label class={kindToggleClass}>
              <input
                class="sr-only"
                type="radio"
                name="baselineKind"
                value="cooper"
                checked={selectedKind === "cooper"}
                data-baseline-kind
              />
              Cooper test
            </label>
            <label class={kindToggleClass}>
              <input
                class="sr-only"
                type="radio"
                name="baselineKind"
                value="skip"
                checked={selectedKind === "skip"}
                data-baseline-kind
              />
              Skip for now
            </label>
          </div>
        </fieldset>

        <div data-panel="last-race" class="flex flex-col gap-4" hidden={selectedKind !== "last-race"}>
          <fieldset>
            <legend class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
              Distance
            </legend>
            <div class="mt-2 grid grid-cols-2 gap-2">
              {RACE_DISTANCES.map((distance) => (
                <label class:list={[chipClass, distance.id === "custom" && "col-span-2"]}>
                  <input
                    class="sr-only"
                    type="radio"
                    name="lastRaceDistance"
                    value={distance.id}
                    data-km={distance.km ?? ""}
                    data-last-race-distance
                    checked={lastRaceDistance === distance.id}
                  />
                  {distance.label}
                </label>
              ))}
            </div>
          </fieldset>
          <label class="flex flex-col gap-2" data-custom-km hidden={lastRaceDistance !== "custom"}>
            <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
              Custom (km)
            </span>
            <input
              type="text"
              name="lastRaceCustomKm"
              value={lastRaceCustomKm}
              inputmode="decimal"
              placeholder="e.g. 8"
              data-custom-km-input
              class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
            />
          </label>
          <label class="flex flex-col gap-2">
            <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
              Time
            </span>
            <input
              type="text"
              name="lastRaceTime"
              value={lastRaceTime}
              inputmode="numeric"
              placeholder="hh:mm:ss"
              autocomplete="off"
              data-last-race-time
              class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
            />
          </label>
          <p class="text-sm text-cloud" data-pace-preview hidden={!lastRacePace}>
            Pace <span data-pace-value>{lastRacePace}</span>
          </p>
          <p
            class="rounded-xl border border-lime/25 bg-lime/8 px-4 py-3 text-xs leading-5 text-[#d6ded6]"
            data-pace-warning
            hidden={!showPaceWarning}
          >
            That pace looks unusual. Typical is about 2:30–12:00 /km. You can still continue.
          </p>
          <label class="flex flex-col gap-2">
            <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
              Race date <span class="normal-case tracking-normal text-mist/80">(optional)</span>
            </span>
            <input
              type="date"
              name="lastRaceDate"
              value={lastRaceDate}
              max={today}
              class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
            />
          </label>
        </div>

        <div data-panel="cooper" class="flex flex-col gap-4" hidden={selectedKind !== "cooper"}>
          <p class="text-sm leading-6 text-[#d6ded6]">Run as far as you can in 12 minutes</p>
          <div class="flex flex-col gap-2">
            <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
              Distance covered
            </span>
            <div class="flex gap-2">
              <input
                type="text"
                name="cooperDistance"
                value={cooperDistance}
                inputmode="decimal"
                placeholder="e.g. 2.4"
                data-cooper-distance
                class="min-w-0 flex-1 rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
              />
              <div class="flex rounded-xl border border-white/12 p-1" role="radiogroup" aria-label="Distance unit">
                <label class="flex cursor-pointer items-center rounded-lg px-3 py-2 text-xs font-semibold text-mist uppercase has-[:checked]:bg-lime has-[:checked]:text-ink">
                  <input class="sr-only" type="radio" name="cooperUnit" value="km" checked data-cooper-unit />
                  km
                </label>
                <label class="flex cursor-pointer items-center rounded-lg px-3 py-2 text-xs font-semibold text-mist uppercase has-[:checked]:bg-lime has-[:checked]:text-ink">
                  <input class="sr-only" type="radio" name="cooperUnit" value="m" data-cooper-unit />
                  m
                </label>
              </div>
            </div>
            <p class="text-xs leading-5 text-mist">0.5–5 km (or 500–5000 m).</p>
          </div>
        </div>

        <div data-panel="skip" hidden={selectedKind !== "skip"}></div>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)]"
        >
          Continue
        </button>
        <p>
          <a
            href="/onboarding?step=2"
            class="inline-flex items-center gap-2 border-b border-lime pb-1 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
          >
            Back
          </a>
        </p>
      </form>
    )
  }

  {
    step === 4 && (
      <form method="post" class="flex flex-col gap-5" data-days-form>
        <input type="hidden" name="intent" value="generate" />
        <fieldset>
          <legend class="sr-only">Days you can run</legend>
          <div class="flex items-center justify-between gap-1" role="group" aria-label="Days you can run">
            {WEEKDAYS.map((day) => (
              <label
                class="relative grid h-10 w-10 flex-1 cursor-pointer place-items-center rounded-full border border-white/12 text-xs font-semibold text-mist transition-colors has-[:checked]:border-lime has-[:checked]:bg-lime has-[:checked]:text-ink"
              >
                <input
                  class="sr-only"
                  type="checkbox"
                  name="days"
                  value={day.id}
                  checked={selectedDays.includes(day.id)}
                  data-day-toggle
                />
                <span aria-hidden="true">{day.abbr}</span>
                <span class="sr-only">{day.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="text-xs leading-5 text-mist" data-days-hint>
          {MIN_TRAINING_DAYS} days selected is enough to generate a plan.
        </p>
        <button
          type="submit"
          data-generate
          class="inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow,opacity] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)] disabled:pointer-events-none disabled:translate-y-0 disabled:opacity-40 disabled:shadow-none"
        >
          Generate my plan
        </button>
        <p>
          <a
            href="/onboarding?step=3"
            class="inline-flex items-center gap-2 border-b border-lime pb-1 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
          >
            Back
          </a>
        </p>
      </form>
    )
  }
</div>

<script>
  const form = document.querySelector("[data-days-form]");
  if (form instanceof HTMLFormElement) {
    const boxes = [...form.querySelectorAll<HTMLInputElement>("[data-day-toggle]")];
    const generate = form.querySelector<HTMLButtonElement>("[data-generate]");
    const hint = form.querySelector("[data-days-hint]");
    const minDays = 3;

    const sync = () => {
      const count = boxes.filter((box) => box.checked).length;
      if (generate) generate.disabled = count < minDays;
      if (hint) {
        hint.textContent =
          count < minDays
            ? `Pick at least ${minDays} days you can run.`
            : `${minDays} days selected is enough to generate a plan.`;
      }
    };

    boxes.forEach((box) => box.addEventListener("change", sync));
    sync();
  }

  const baselineForm = document.querySelector("[data-baseline-form]");
  if (baselineForm instanceof HTMLFormElement) {
    const kindInputs = [...baselineForm.querySelectorAll<HTMLInputElement>("[data-baseline-kind]")];
    const panels = [...baselineForm.querySelectorAll<HTMLElement>("[data-panel]")];
    const distanceInputs = [
      ...baselineForm.querySelectorAll<HTMLInputElement>("[data-last-race-distance]"),
    ];
    const customWrap = baselineForm.querySelector<HTMLElement>("[data-custom-km]");
    const customInput = baselineForm.querySelector<HTMLInputElement>("[data-custom-km-input]");
    const timeInput = baselineForm.querySelector<HTMLInputElement>("[data-last-race-time]");
    const pacePreview = baselineForm.querySelector<HTMLElement>("[data-pace-preview]");
    const paceValue = baselineForm.querySelector("[data-pace-value]");
    const paceWarning = baselineForm.querySelector<HTMLElement>("[data-pace-warning]");

    const parseHms = (raw: string) => {
      const match = /^(\d{1,2}):([0-5]\d):([0-5]\d)$/.exec(raw.trim());
      if (!match) return null;
      return Number(match[1]) * 3600 + Number(match[2]) * 60 + Number(match[3]);
    };

    const selectedKind = () => kindInputs.find((input) => input.checked)?.value ?? "last-race";

    const selectedKm = () => {
      const selected = distanceInputs.find((input) => input.checked);
      if (!selected) return 0;
      if (selected.value === "custom") {
        const amount = Number((customInput?.value ?? "").trim().replace(",", "."));
        return Number.isFinite(amount) && amount > 0 ? amount : 0;
      }
      const km = Number(selected.dataset.km);
      return Number.isFinite(km) ? km : 0;
    };

    const formatPace = (secPerKm: number) => {
      const rounded = Math.round(secPerKm);
      const minutes = Math.floor(rounded / 60);
      const seconds = rounded % 60;
      return `${minutes}:${String(seconds).padStart(2, "0")} /km`;
    };

    const syncPace = () => {
      const timeSeconds = parseHms(timeInput?.value ?? "");
      const km = selectedKm();
      const pace = timeSeconds && timeSeconds > 0 && km > 0 ? timeSeconds / km : 0;
      if (pacePreview) pacePreview.hidden = !(pace > 0);
      if (paceValue && pace > 0) paceValue.textContent = formatPace(pace);
      if (paceWarning) paceWarning.hidden = !(pace > 0 && (pace < 150 || pace > 720));
    };

    const sync = () => {
      const kind = selectedKind();
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== kind;
      });
      const customSelected = distanceInputs.some((input) => input.checked && input.value === "custom");
      if (customWrap) customWrap.hidden = kind !== "last-race" || !customSelected;
      syncPace();
    };

    kindInputs.forEach((input) => input.addEventListener("change", sync));
    distanceInputs.forEach((input) => input.addEventListener("change", sync));
    customInput?.addEventListener("input", syncPace);
    timeInput?.addEventListener("input", syncPace);
    sync();
  }
</script>
