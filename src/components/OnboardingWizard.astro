---
import {
  DEFAULT_DAYS,
  GOALS,
  LEVELS,
  MIN_TRAINING_DAYS,
  WEEKDAYS,
  utcTodayYmd,
  type OnboardingRecord,
} from "../lib/training";

interface Props {
  step: 1 | 2 | 3;
  error?: string;
  draft: OnboardingRecord | null;
}

const { step, error = "", draft } = Astro.props;
const today = utcTodayYmd();
const selectedDays = draft?.days?.length ? draft.days : DEFAULT_DAYS;
const raceDate = draft?.raceDate ?? "";

const headings = {
  1: { title: "Your goal", sub: "What are you training for?" },
  2: { title: "Your level", sub: "We’ll scale the first plan to this." },
  3: { title: "Your days", sub: "Pick at least three days you can run." },
} as const;

const heading = headings[step];
---

<div class="flex max-w-md flex-col gap-5">
  <div>
    <p class="text-[0.66rem] font-semibold tracking-[0.13em] text-lime uppercase">{step} / 3</p>
    <div class="mt-3 flex gap-1.5" aria-hidden="true">
      {
        [1, 2, 3].map((index) => (
          <span
            class:list={[
              "h-1 flex-1 rounded-full",
              index <= step ? "bg-lime" : "bg-white/12",
            ]}
          />
        ))
      }
    </div>
    <p class="sr-only">Step {step} of 3</p>
  </div>

  <div>
    <h1
      class="max-w-[16ch] text-[clamp(1.85rem,6vw,3rem)] leading-[0.9] font-bold tracking-[-0.04em] text-cloud uppercase"
    >
      {heading.title}
    </h1>
    <p class="mt-3 text-sm leading-6 text-[#d6ded6]">{heading.sub}</p>
  </div>

  {
    error && (
      <p
        class="rounded-xl border border-[#ff8a80]/30 bg-[#ff8a80]/8 px-4 py-3 text-sm leading-6 text-[#ffb4aa]"
        role="alert"
      >
        {error}
      </p>
    )
  }

  {
    step === 1 && (
      <form method="post" class="flex flex-col gap-4">
        <label class="flex flex-col gap-2">
          <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
            Race date <span class="normal-case tracking-normal text-mist/80">(optional)</span>
          </span>
          <input
            type="date"
            name="raceDate"
            value={raceDate ?? ""}
            min={today}
            class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
          />
        </label>
        <p class="text-xs leading-5 text-mist">
          Skip if you don’t have a race. Not needed for Just consistent.
        </p>
        <div class="grid grid-cols-2 gap-2">
          {GOALS.map((goal) => (
            <button
              type="submit"
              name="goal"
              value={goal.id}
              class:list={[
                "rounded-2xl border border-white/12 bg-panel px-4 py-3.5 text-sm font-semibold text-cloud transition-colors hover:border-lime/50 hover:bg-white/[0.04]",
                goal.id === "consistent" && "col-span-2",
              ]}
            >
              {goal.label}
            </button>
          ))}
        </div>
      </form>
    )
  }

  {
    step === 2 && (
      <form method="post" class="flex flex-col gap-2">
        {LEVELS.map((level) => (
          <button
            type="submit"
            name="level"
            value={level.id}
            class="rounded-2xl border border-white/12 bg-panel px-4 py-3.5 text-left transition-colors hover:border-lime/50 hover:bg-white/[0.04]"
          >
            <span class="block text-sm font-semibold text-cloud">{level.label}</span>
            <span class="mt-1 block text-xs leading-5 font-normal text-mist">{level.help}</span>
          </button>
        ))}
        <p class="pt-2">
          <a
            href="/onboarding?step=1"
            class="inline-flex items-center gap-2 border-b border-lime pb-1 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
          >
            Back
          </a>
        </p>
      </form>
    )
  }

  {
    step === 3 && (
      <form method="post" class="flex flex-col gap-5" data-days-form>
        <input type="hidden" name="intent" value="generate" />
        <fieldset>
          <legend class="sr-only">Days you can run</legend>
          <div class="flex items-center justify-between gap-1" role="group" aria-label="Days you can run">
            {WEEKDAYS.map((day) => (
              <label
                class="relative grid h-10 w-10 flex-1 cursor-pointer place-items-center rounded-full border border-white/12 text-xs font-semibold text-mist transition-colors has-[:checked]:border-lime has-[:checked]:bg-lime has-[:checked]:text-ink"
              >
                <input
                  class="sr-only"
                  type="checkbox"
                  name="days"
                  value={day.id}
                  checked={selectedDays.includes(day.id)}
                  data-day-toggle
                />
                <span aria-hidden="true">{day.abbr}</span>
                <span class="sr-only">{day.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <p class="text-xs leading-5 text-mist" data-days-hint>
          {MIN_TRAINING_DAYS} days selected is enough to generate a plan.
        </p>
        <button
          type="submit"
          data-generate
          class="inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow,opacity] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)] disabled:pointer-events-none disabled:translate-y-0 disabled:opacity-40 disabled:shadow-none"
        >
          Generate my plan
        </button>
        <p>
          <a
            href="/onboarding?step=2"
            class="inline-flex items-center gap-2 border-b border-lime pb-1 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
          >
            Back
          </a>
        </p>
      </form>
    )
  }
</div>

<script>
  const form = document.querySelector("[data-days-form]");
  if (form instanceof HTMLFormElement) {
    const boxes = [...form.querySelectorAll<HTMLInputElement>("[data-day-toggle]")];
    const generate = form.querySelector<HTMLButtonElement>("[data-generate]");
    const hint = form.querySelector("[data-days-hint]");
    const minDays = 3;

    const sync = () => {
      const count = boxes.filter((box) => box.checked).length;
      if (generate) generate.disabled = count < minDays;
      if (hint) {
        hint.textContent =
          count < minDays
            ? `Pick at least ${minDays} days you can run.`
            : `${minDays} days selected is enough to generate a plan.`;
      }
    };

    boxes.forEach((box) => box.addEventListener("change", sync));
    sync();
  }
</script>
