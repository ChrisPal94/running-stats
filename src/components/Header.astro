<header class="relative z-20 flex items-center justify-between gap-6 px-5 py-5 sm:px-8 lg:px-12 lg:py-7">
  <a
    class="group flex items-center gap-3 rounded-sm"
    href="#top"
    aria-label="Running Stats home"
  >
    <svg
      class="h-9 w-9 text-lime transition-transform duration-300 ease-out group-hover:-rotate-6"
      viewBox="0 0 48 48"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M29.8 5.5c3.2 0 5.7 2.6 5.7 5.8 0 3.1-2.5 5.7-5.7 5.7a5.8 5.8 0 0 1 0-11.5Z"
        fill="currentColor"
      />
      <path
        d="m19.4 18.7 7.5-2.8c2-.8 4.3 0 5.4 1.8l3 4.8 5.4 1.4-1.8 5.3-6.5-2a4.4 4.4 0 0 1-2.3-1.7l-1.3-2-3.5 5 5.3 4.8-4 9.2-5.5-2.4 2.8-6.2-5.7-4.7-4.3 5.2-7-1.7 1.4-5.5 3.2.8 5.2-6.7c1-1.2 2.2-2 3.7-2.6Z"
        fill="currentColor"
      />
    </svg>
    <span class="hidden text-sm font-bold tracking-[0.16em] text-cloud uppercase sm:inline">
      Running Stats
    </span>
  </a>

  <nav aria-label="Primary navigation" class="hidden lg:block">
    <ul class="flex items-center gap-1 rounded-full border border-white/10 bg-black/20 p-1.5 backdrop-blur-md">
      {
        ["Home", "Features", "Community", "Contact"].map((item, index) => (
          <li>
            <a
              href={index === 0 ? "#top" : `#${item.toLowerCase()}`}
              class:list={[
                "block rounded-full px-5 py-2.5 text-xs font-medium transition-colors duration-200",
                index === 0
                  ? "bg-white/10 text-white"
                  : "text-mist hover:bg-white/6 hover:text-white",
              ]}
            >
              {item}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a
    href="#start"
    class="rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)] sm:px-6"
  >
    Start tracking
  </a>
</header>
