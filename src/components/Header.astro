---
import BrandLogo from "./BrandLogo.astro";
import PrimaryCta from "./PrimaryCta.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { label: "Home", href: "/#top" },
  { label: "How it works", href: "/#how" },
] as const;
---

<header class="relative z-20 px-5 py-3 sm:px-8 sm:py-5 lg:px-12 lg:py-7">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 sm:gap-x-6 sm:gap-y-4">
    <BrandLogo class="rounded-sm" href="/#top" label="Stride Lab home" />

    <PrimaryCta class="order-none sm:px-6 lg:order-last" />

    <nav
      aria-label="Primary navigation"
      class="flex w-full justify-center lg:w-auto lg:flex-1"
    >
      <ul
        class="flex items-center gap-1 overflow-x-auto rounded-full border border-white/10 bg-black/20 p-1.5 backdrop-blur-md"
      >
        {
          navItems.map((item) => {
            const isHome = item.href === "/#top";
            const isActive = isHome && pathname === "/";

            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "block whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium transition-colors duration-200 sm:px-5 sm:py-2.5",
                    isActive
                      ? "bg-white/10 text-white"
                      : "text-mist hover:bg-white/6 hover:text-white",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
