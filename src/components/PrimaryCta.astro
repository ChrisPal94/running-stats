---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="/signup"
  class:list={[
    "inline-flex shrink-0 items-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)]",
    className,
  ]}
>
  Start your plan
</a>
