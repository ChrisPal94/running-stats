---
import LogRunSheet from "./LogRunSheet.astro";
import RunDetail from "./RunDetail.astro";
import RunMap from "./RunMap.astro";
import WhySheet from "./WhySheet.astro";
import { COACH_FEEDBACK_TITLE } from "../lib/ollama-feedback";
import {
  EMPTY_RUN_ROUTE,
  EMPTY_TODAY_COPY,
  SEE_THE_WEEK_CTA,
  formatHms,
  formatPace,
  type AdaptationEvent,
  type Feedback,
  type FeedbackKind,
  type RunLog,
  type RunLogFormDraft,
  type Session,
} from "../lib/training";

interface Props {
  session: Session | null;
  nextRunHint?: string | null;
  feedback: Feedback | null;
  runLog?: RunLog | null;
  adaptationEvent: AdaptationEvent | null;
  sourceFeedbackKind?: FeedbackKind | null;
  logOpen?: boolean;
  logError?: string;
  logDraft?: RunLogFormDraft | null;
  feedbackError?: string;
  savedToast?: boolean;
}

const {
  session,
  nextRunHint = null,
  feedback = null,
  runLog = null,
  adaptationEvent = null,
  sourceFeedbackKind = null,
  logOpen = false,
  logError = "",
  logDraft = null,
  feedbackError = "",
  savedToast = false,
} = Astro.props;
const adaptationSummary = adaptationEvent?.summary || "";
const adaptationReason = adaptationEvent?.reason || "";
const route = runLog?.route ?? EMPTY_RUN_ROUTE;

const status =
  session?.outcome === "done"
    ? "Done"
    : session?.outcome === "skipped"
      ? "Skipped"
      : feedback?.kind === "feeling-off"
        ? "Noted"
        : "Up next";

const canAct = Boolean(session && !feedback);
const canLog = canAct && runLog?.source !== "intervals";
---

<article
  class="flex flex-col rounded-[1.75rem] border border-white/12 bg-[#111718]/82 p-5 shadow-[0_18px_50px_rgba(0,0,0,0.3)] backdrop-blur-md sm:p-6"
  aria-labelledby={session ? "today-view-title" : "today-empty-title"}
>
  <div class="flex items-start justify-between gap-4">
    {
      session ? (
        <h1
          id="today-view-title"
          class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase"
        >
          Today
        </h1>
      ) : (
        <p class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">Today</p>
      )
    }
    {
      session ? (
        <span
          class:list={[
            "rounded-full border px-3 py-1 text-[0.62rem] font-semibold tracking-wider uppercase",
            session.outcome === "skipped" || feedback?.kind === "feeling-off"
              ? "border-white/20 text-mist"
              : "border-lime/40 text-lime",
          ]}
        >
          {status}
        </span>
      ) : null
    }
  </div>

  {
    session ? (
      <>
        <p class="mt-8 text-[clamp(1.75rem,8vw,2.5rem)] leading-none font-semibold tracking-[-0.04em] text-cloud">
          {session.title}
        </p>
        <p class="mt-3 text-sm text-[#d6ded6]">{session.cue}</p>
      </>
    ) : (
      <h1
        id="today-empty-title"
        class="mt-8 text-[clamp(1.75rem,8vw,2.5rem)] leading-none font-semibold tracking-[-0.04em] text-cloud"
      >
        {EMPTY_TODAY_COPY}
      </h1>
    )
  }

  {
    runLog && (
      <section
        class="mt-6 rounded-2xl border border-white/12 bg-black/30 p-4"
        aria-labelledby="logged-run-title"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h2 id="logged-run-title" class="text-sm font-semibold text-cloud">
            You ran
          </h2>
          {
            runLog.source === "intervals" ? (
              <p class="text-[0.62rem] font-semibold tracking-wider text-mist uppercase">From Intervals</p>
            ) : null
          }
        </div>
        <dl class="mt-4 grid grid-cols-3 divide-x divide-white/10">
          <div class="pr-3">
            <dt class="text-[0.58rem] tracking-wider text-mist uppercase">Distance</dt>
            <dd class="mt-1 text-sm font-semibold text-cloud tabular-nums">{runLog.distanceKm} km</dd>
          </div>
          <div class="px-3">
            <dt class="text-[0.58rem] tracking-wider text-mist uppercase">Time</dt>
            <dd class="mt-1 text-sm font-semibold text-cloud tabular-nums">{formatHms(runLog.timeSec)}</dd>
          </div>
          <div class="pl-3">
            <dt class="text-[0.58rem] tracking-wider text-mist uppercase">Pace</dt>
            <dd class="mt-1 text-sm font-semibold text-cloud tabular-nums">{formatPace(runLog.paceSecPerKm)}</dd>
          </div>
        </dl>
        <div class="mt-4">
          <RunMap route={route} />
        </div>
        {route.type === "polyline" || (route.samples?.length ?? 0) >= 2 ? <RunDetail runLog={runLog} /> : null}
        {
          adaptationEvent?.title === COACH_FEEDBACK_TITLE ? (
            <div class="mt-4 border-t border-white/10 pt-4" aria-labelledby="logged-run-feedback">
              <div class="flex items-center justify-between gap-3">
                <h3 id="logged-run-feedback" class="text-sm font-semibold text-cloud">
                  Feedback
                </h3>
                <WhySheet reason={adaptationReason} basedOn={sourceFeedbackKind} />
              </div>
              {
                adaptationSummary ? (
                  <p class="mt-2 text-sm leading-6 text-[#d6ded6]">{adaptationSummary}</p>
                ) : null
              }
              {session ? (
              <form method="post" class="mt-4">
                <input type="hidden" name="intent" value="generate-feedback" />
                <input type="hidden" name="sessionId" value={session.id} />
                <button
                  type="submit"
                  data-generate-feedback
                  aria-live="polite"
                  class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/12 bg-transparent px-5 py-3 text-xs font-bold text-cloud uppercase transition-colors hover:border-lime/50 hover:bg-white/[0.04] disabled:cursor-wait disabled:opacity-70"
                >
                  <span data-generate-label>Generate again</span>
                  <span data-generate-pending hidden class="inline-flex items-center gap-2">
                    <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="2.5"></circle>
                      <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                    </svg>
                    Generating
                  </span>
                </button>
              </form>
              ) : null}
            </div>
          ) : session && !adaptationEvent ? (
            <form method="post" class="mt-4">
              <input type="hidden" name="intent" value="generate-feedback" />
              <input type="hidden" name="sessionId" value={session.id} />
              {
                feedbackError ? (
                  <p
                    class="mb-3 rounded-xl border border-[#ff8a80]/30 bg-[#ff8a80]/8 px-4 py-3 text-sm leading-6 text-[#ffb4aa]"
                    role="alert"
                  >
                    {feedbackError}
                  </p>
                ) : null
              }
              <button
                type="submit"
                data-generate-feedback
                aria-live="polite"
                class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-white/12 bg-transparent px-5 py-3 text-xs font-bold text-cloud uppercase transition-colors hover:border-lime/50 hover:bg-white/[0.04] disabled:cursor-wait disabled:opacity-70"
              >
                <span data-generate-label>Generate feedback</span>
                <span data-generate-pending hidden class="inline-flex items-center gap-2">
                  <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity="0.25" stroke-width="2.5"></circle>
                    <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path>
                  </svg>
                  Generating
                </span>
              </button>
            </form>
          ) : null
        }
      </section>
    )
  }

  {
    adaptationEvent && adaptationEvent.title !== COACH_FEEDBACK_TITLE && (
      <div
        class="mt-8 rounded-2xl border border-lime/30 bg-lime/8 p-4 sm:p-5"
        aria-labelledby="adaptation-event-title"
      >
        <div class="flex items-center justify-between gap-3">
          <p
            id="adaptation-event-title"
            class="rounded-full border border-lime/40 px-3 py-1 text-[0.62rem] font-semibold tracking-wider text-lime uppercase"
          >
            {adaptationEvent.title}
          </p>
          <WhySheet reason={adaptationReason} basedOn={sourceFeedbackKind} />
        </div>
        {adaptationSummary ? <p class="mt-3 text-sm leading-6 text-cloud">{adaptationSummary}</p> : null}
      </div>
    )
  }

  {
    feedback?.kind === "feeling-off" && !adaptationEvent && (
      <p
        class="mt-6 rounded-2xl border border-white/12 bg-white/[0.03] px-4 py-3 text-sm leading-6 text-[#d6ded6]"
        role="status"
      >
        Got it. Your next session updates tonight.
      </p>
    )
  }

  {
    canAct && session && (
      <div class="mt-8 flex flex-col gap-2">
        {
          canLog ? (
            <LogRunSheet
              sessionId={session.id}
              plannedDistanceKm={session.distanceKm}
              open={logOpen}
              error={logError}
              draft={logDraft}
            />
          ) : null
        }
        <form method="post" class="flex flex-col gap-2">
          <input type="hidden" name="sessionId" value={session.id} />
          <button
            type="submit"
            name="intent"
            value="skip"
            class="inline-flex w-full items-center justify-center rounded-full border border-white/12 bg-transparent px-5 py-3 text-xs font-bold text-cloud uppercase transition-colors hover:border-lime/50 hover:bg-white/[0.04]"
          >
            Skip
          </button>
          <button
            type="submit"
            name="intent"
            value="feeling-off"
            class="inline-flex w-full items-center justify-center px-5 py-3 text-xs font-bold tracking-[0.13em] text-mist uppercase transition-colors hover:text-cloud"
          >
            Feeling off
          </button>
        </form>
      </div>
    )
  }

  {
    !session && (
      <>
        {
          nextRunHint ? (
            <p class="mt-3 text-sm leading-6 text-[#d6ded6]">{nextRunHint}</p>
          ) : null
        }
        <p class="mt-8">
          <a
            href="/plan"
            class="inline-flex items-center gap-2 border-b border-lime pb-1 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
          >
            {SEE_THE_WEEK_CTA}
          </a>
        </p>
      </>
    )
  }
</article>

<script>
  document.querySelectorAll("[data-generate-feedback]").forEach((button) => {
    const form = button.closest("form");
    if (!(button instanceof HTMLButtonElement) || !(form instanceof HTMLFormElement)) return;
    const label = button.querySelector("[data-generate-label]");
    const pending = button.querySelector("[data-generate-pending]");
    form.addEventListener("submit", () => {
      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      if (label instanceof HTMLElement) label.hidden = true;
      if (pending instanceof HTMLElement) pending.hidden = false;
    });
  });
</script>

{
  savedToast ? (
    <p
      class="saved-toast pointer-events-none fixed inset-x-0 bottom-24 z-50 mx-auto w-max rounded-full bg-lime px-4 py-2 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)]"
      data-saved-toast
      role="status"
    >
      Saved
    </p>
  ) : null
}

{
  savedToast ? (
    <script>
      const toast = document.querySelector("[data-saved-toast]");
      window.setTimeout(() => {
        if (toast instanceof HTMLElement) toast.hidden = true;
        if (window.location.search.includes("saved=1")) {
          history.replaceState({}, "", "/today");
        }
      }, 1800);
    </script>
  ) : null
}