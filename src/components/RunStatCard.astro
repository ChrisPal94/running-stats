<article
  class="relative min-h-60 overflow-hidden rounded-[1.75rem] border border-white/12 bg-[#111718]/82 p-5 shadow-[0_18px_50px_rgba(0,0,0,0.3)] backdrop-blur-md sm:min-h-64 sm:p-6"
  aria-labelledby="latest-run-title"
>
  <div class="relative z-10 flex items-start justify-between gap-4">
    <div>
      <p id="latest-run-title" class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">
        Latest run
      </p>
      <p class="mt-1 text-4xl leading-none font-semibold tracking-[-0.04em] text-cloud tabular-nums">
        9.90<span class="ml-1 text-sm tracking-normal text-mist">KM</span>
      </p>
    </div>
    <span class="rounded-full border border-lime/40 px-3 py-1 text-[0.62rem] font-semibold tracking-wider text-lime uppercase">
      Completed
    </span>
  </div>

  <svg
    class="absolute inset-x-4 top-[5.8rem] h-25 w-[calc(100%-2rem)] text-lime sm:h-28"
    viewBox="0 0 300 110"
    fill="none"
    role="img"
    aria-label="Illustrative route map"
  >
    <path
      d="M14 81c19-34 33 8 48-22 11-23 18 12 34-12 9-14 17-17 27 1 11 19 30 22 45 5 17-19 21-51 45-36 12 8-2 28 17 34 17 5 28-18 54-10"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M13 81c28 5 41 13 67 10 32-4 53-12 83-4 33 9 60 5 122-46"
      stroke="white"
      stroke-opacity=".2"
      stroke-width="1.5"
      stroke-dasharray="4 8"
    />
    <circle cx="14" cy="81" r="5" fill="#05090b" stroke="currentColor" stroke-width="3" />
    <circle cx="284" cy="41" r="5" fill="currentColor" />
  </svg>

  <dl class="absolute inset-x-5 bottom-5 grid grid-cols-3 divide-x divide-white/10 sm:inset-x-6">
    <div class="pr-3">
      <dt class="text-[0.58rem] tracking-wider text-mist uppercase">Pace</dt>
      <dd class="mt-1 text-xs font-semibold text-cloud tabular-nums">5:12 /KM</dd>
    </div>
    <div class="px-3">
      <dt class="text-[0.58rem] tracking-wider text-mist uppercase">Time</dt>
      <dd class="mt-1 text-xs font-semibold text-cloud tabular-nums">51 MIN</dd>
    </div>
    <div class="pl-3">
      <dt class="text-[0.58rem] tracking-wider text-mist uppercase">Energy</dt>
      <dd class="mt-1 text-xs font-semibold text-cloud tabular-nums">640 CAL</dd>
    </div>
  </dl>
</article>
