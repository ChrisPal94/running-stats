---
import {
  INTERVALS_ACCESS_EXPIRED,
  INTERVALS_CONNECT_COPY,
  INTERVALS_CONNECT_UNAVAILABLE,
  INTERVALS_KEY_HELP,
  INTERVALS_KEY_HELP_URL,
  INTERVALS_OAUTH_CONNECT_BUTTON,
  INTERVALS_OAUTH_CONNECT_LINE,
  INTERVALS_ROW_ID,
  INTERVALS_SYNC_NEEDS_CONNECT,
  intervalsSettingsControls,
  type IntervalsConnectionView,
} from "../lib/intervals";

interface Props {
  connection: IntervalsConnectionView;
  error?: string;
  /** Athlete id to refill after a failed connect. Never the API key. */
  athleteIdDraft?: string;
  /** True when INTERVALS_CLIENT_ID and INTERVALS_CLIENT_SECRET are set. */
  oauthConfigured?: boolean;
  /** False when INTERVALS_KEY_ENC_SECRET is missing or the wrong length. */
  encryptionReady?: boolean;
  /** Verified owner env-key connect when OAuth and pasted-key connect are both unavailable. */
  envFallbackConnect?: boolean;
}

const {
  connection,
  error = "",
  athleteIdDraft = "",
  oauthConfigured = false,
  encryptionReady = true,
  envFallbackConnect = false,
} = Astro.props;
const controls = intervalsSettingsControls({ available: true, connection });
const reconnecting = connection.connected && connection.needsReconnect === true;
const showKeyForm =
  (!connection.connected || reconnecting) && !oauthConfigured && !envFallbackConnect && encryptionReady;
const connectDisabled = (!connection.connected || reconnecting) && !envFallbackConnect && !encryptionReady;
const showSync = connection.connected && !reconnecting;
const connectLabel = reconnecting
  ? "Reconnect"
  : oauthConfigured || connectDisabled
    ? INTERVALS_OAUTH_CONNECT_BUTTON
    : "Connect";
const statusLabel = reconnecting ? INTERVALS_ACCESS_EXPIRED : controls.statusLabel;
let helper = "";
let helperIsError = false;
if (!connection.connected || reconnecting) {
  if (connectDisabled) helper = INTERVALS_CONNECT_UNAVAILABLE;
  else if (showKeyForm) helper = INTERVALS_CONNECT_COPY;
  else if (oauthConfigured && !reconnecting) helper = INTERVALS_OAUTH_CONNECT_LINE;
} else if (connection.lastSyncLabel) {
  helper = connection.lastSyncLabel;
  helperIsError = Boolean(connection.lastSyncError);
}
const secondaryClass =
  "inline-flex w-full items-center justify-center rounded-full border border-white/12 px-5 py-3 text-xs font-bold text-cloud uppercase transition-colors hover:border-lime/50 hover:bg-white/[0.04]";
const primaryClass =
  "inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)]";
const disabledClass =
  "inline-flex w-full cursor-not-allowed items-center justify-center rounded-full bg-lime/40 px-5 py-3 text-xs font-bold text-ink/70 uppercase";
---

<article
  id={INTERVALS_ROW_ID}
  class="flex flex-col rounded-[1.75rem] border border-white/12 bg-[#111718]/82 p-5 shadow-[0_18px_50px_rgba(0,0,0,0.3)] backdrop-blur-md sm:p-6"
>
  <h2 class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">Connected apps</h2>
  <div class="mt-6 flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-cloud">Intervals.icu</p>
      <p class="mt-1 text-xs leading-5 text-mist">{statusLabel}</p>
    </div>
  </div>

  {
    error && (
      <p
        class="mt-4 rounded-xl border border-[#ff8a80]/30 bg-[#ff8a80]/8 px-4 py-3 text-sm leading-6 text-[#ffb4aa]"
        role="alert"
      >
        {
          error === INTERVALS_SYNC_NEEDS_CONNECT ? (
            <>
              <a href={`/settings#${INTERVALS_ROW_ID}`} class="underline underline-offset-2">
                Connect Intervals.icu
              </a>
              {" to import your runs."}
            </>
          ) : (
            error
          )
        }
      </p>
    )
  }

  <div class="mt-5 flex flex-col gap-3" data-intervals-actions>
    {
      showKeyForm ? (
        <form id="intervals-key-form" method="post" class="flex flex-col gap-3">
          <input type="hidden" name="intent" value="intervals-connect" />
          <label class="flex flex-col gap-2">
            <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">API key</span>
            <input
              type="password"
              name="intervalsApiKey"
              autocomplete="off"
              spellcheck="false"
              maxlength="256"
              class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
            />
          </label>
          <label class="flex flex-col gap-2">
            <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">Athlete ID</span>
            <input
              type="text"
              name="intervalsAthleteId"
              value={athleteIdDraft}
              placeholder="i123456"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
              maxlength="16"
              class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
            />
          </label>
        </form>
      ) : null
    }
    <div class="flex flex-col gap-2 sm:flex-row">
      {
        showSync ? (
          <form method="post" class="sm:flex-1">
            <input type="hidden" name="intent" value="intervals-sync" />
            <button type="submit" class={primaryClass}>
              Sync now
            </button>
          </form>
        ) : connectDisabled ? (
          <button type="button" class:list={[disabledClass, "sm:flex-1"]} disabled>
            {connectLabel}
          </button>
        ) : showKeyForm ? (
          <button type="submit" form="intervals-key-form" class:list={[primaryClass, "sm:flex-1"]}>
            {connectLabel}
          </button>
        ) : envFallbackConnect ? (
          <form method="post" class="sm:flex-1">
            <input type="hidden" name="intent" value="intervals-connect" />
            <button type="submit" class={primaryClass}>
              {connectLabel}
            </button>
          </form>
        ) : (
          <a href="/auth/intervals/start" class:list={[primaryClass, "sm:flex-1"]}>
            {connectLabel}
          </a>
        )
      }
      {
        connection.connected ? (
          <form method="post" class="sm:flex-1" data-confirm="Disconnect Intervals.icu?">
            <input type="hidden" name="intent" value="intervals-disconnect" />
            <button type="submit" class={secondaryClass}>
              Disconnect
            </button>
          </form>
        ) : null
      }
    </div>
  </div>

  <div
    class:list={["mt-4 min-h-5 text-xs leading-5", helperIsError ? "text-[#ffb4aa]" : "text-mist"]}
    data-intervals-helper
  >
    {helper ? <p role="status">{helper}</p> : null}
    {
      showKeyForm ? (
        <p class:list={[helper ? "mt-3" : undefined]}>
          <a
            href={INTERVALS_KEY_HELP_URL}
            class="underline underline-offset-2 hover:text-cloud"
            target="_blank"
            rel="noopener noreferrer"
          >
            {INTERVALS_KEY_HELP}
          </a>
        </p>
      ) : null
    }
  </div>
</article>
<script>
  for (const form of document.querySelectorAll("form[data-confirm]")) {
    form.addEventListener("submit", (event) => {
      const message = form.getAttribute("data-confirm");
      if (message && !window.confirm(message)) event.preventDefault();
    });
  }
</script>
