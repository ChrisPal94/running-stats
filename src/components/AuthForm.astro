---
import { SIGNUP_DUPLICATE_ERROR } from "../lib/auth";

interface Props {
  email?: string;
  error?: string;
  passwordAutocomplete: "new-password" | "current-password";
  footerHref: string;
  footerLabel: string;
  googleFrom: "login" | "signup";
  method?: "password" | "link";
  magicSent?: boolean;
  resendWaitMs?: number;
}

const {
  email = "",
  error = "",
  passwordAutocomplete,
  footerHref,
  footerLabel,
  googleFrom,
  method = "password",
  magicSent = false,
  resendWaitMs = 0,
} = Astro.props;

const alertLinkClass =
  "font-semibold text-cloud underline decoration-lime/70 underline-offset-[3px] hover:decoration-lime focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-lime";
const linkSelected = method === "link";
const passwordHref = googleFrom === "login" ? "/login" : "/signup";
const linkHref = `${passwordHref}?method=link`;
const tabClass = (active: boolean) =>
  [
    "rounded-full px-3 py-2 text-center text-xs font-bold tracking-[0.08em] uppercase transition-colors",
    active ? "bg-lime text-ink" : "text-mist hover:text-cloud",
  ].join(" ");
---

<div class="flex max-w-md flex-col gap-5">
  <div class="grid grid-cols-2 rounded-full border border-white/12 bg-black/20 p-1" role="tablist" aria-label="Sign in method">
    <a
      href={passwordHref}
      role="tab"
      aria-selected={linkSelected ? "false" : "true"}
      class={tabClass(!linkSelected)}
    >
      Password
    </a>
    <a
      href={linkHref}
      role="tab"
      aria-selected={linkSelected ? "true" : "false"}
      class={tabClass(linkSelected)}
    >
      Email link
    </a>
  </div>

  {
    !linkSelected ? (
      <form method="post" class="flex flex-col gap-5">
        {error && (
          <p
            class="rounded-xl border border-[#ff8a80]/30 bg-[#ff8a80]/8 px-4 py-3 text-sm leading-6 text-[#ffb4aa]"
            role="alert"
          >
            {
              error === SIGNUP_DUPLICATE_ERROR ? (
                <>
                  Couldn’t create your account. If you already have one,{" "}
                  <a
                    href="/login"
                    class={alertLinkClass}
                  >
                    log in
                  </a>
                  ,{" "}
                  <a
                    href="/login?method=link"
                    class={alertLinkClass}
                  >
                    sign in with an email link
                  </a>
                  , or{" "}
                  <a
                    href={`/auth/google?from=${googleFrom}`}
                    class={alertLinkClass}
                  >
                    continue with Google
                  </a>
                  .
                </>
              ) : (
                error
              )
            }
          </p>
        )}

        <input type="hidden" name="intent" value="password" />

        <label class="flex flex-col gap-2">
          <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">Email</span>
          <input
            type="email"
            name="email"
            value={email}
            autocomplete="email"
            inputmode="email"
            autocapitalize="off"
            spellcheck="false"
            required
            maxlength="254"
            class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
          />
        </label>

        <label class="flex flex-col gap-2">
          <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">Password</span>
          <input
            type="password"
            name="password"
            autocomplete={passwordAutocomplete}
            required
            minlength="8"
            maxlength="128"
            class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
          />
        </label>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)]"
        >
          Continue
        </button>
      </form>
    ) : magicSent ? (
      <div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <p class="text-base font-semibold text-cloud">Check your email</p>
          <p class="text-sm text-mist">Link expires in 15 minutes</p>
        </div>
        <form method="post" class="flex flex-col gap-3" action={linkHref}>
          <input type="hidden" name="intent" value="magic" />
          <input type="hidden" name="email" value={email} />
          <button
            type="submit"
            class="inline-flex w-full items-center justify-center rounded-full border border-white/12 bg-transparent px-5 py-3 text-xs font-bold text-cloud uppercase transition-colors hover:border-white/20 hover:bg-white/[0.04] disabled:cursor-not-allowed disabled:opacity-50"
            data-magic-resend
            data-wait-ms={resendWaitMs}
            disabled={resendWaitMs > 0}
          >
            Resend link
          </button>
        </form>
      </div>
    ) : (
      <form method="post" class="flex flex-col gap-5" action={linkHref}>
        {error && (
          <p
            class="rounded-xl border border-[#ff8a80]/30 bg-[#ff8a80]/8 px-4 py-3 text-sm leading-6 text-[#ffb4aa]"
            role="alert"
          >
            {error}
          </p>
        )}

        <input type="hidden" name="intent" value="magic" />

        <label class="flex flex-col gap-2">
          <span class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase">Email</span>
          <input
            type="email"
            name="email"
            value={email}
            autocomplete="email"
            inputmode="email"
            autocapitalize="off"
            spellcheck="false"
            required
            maxlength="254"
            class="w-full rounded-xl border border-white/12 bg-panel px-4 py-3 text-sm text-cloud outline-none transition-colors placeholder:text-mist/50 focus:border-lime"
          />
        </label>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)]"
        >
          Email me a link
        </button>
      </form>
    )
  }

  {
    !magicSent && (
      <>
        <div class="flex items-center gap-3">
          <span class="h-px flex-1 bg-white/12"></span>
          <span class="text-xs text-mist">or</span>
          <span class="h-px flex-1 bg-white/12"></span>
        </div>

        <a
          href={`/auth/google?from=${googleFrom}`}
          class="inline-flex w-full items-center justify-center gap-3 rounded-full border border-white/12 bg-transparent px-5 py-3 text-sm font-semibold text-cloud transition-colors hover:border-white/20 hover:bg-white/[0.04]"
        >
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          Continue with Google
        </a>
      </>
    )
  }

  <p>
    <a
      href={footerHref}
      class="inline-flex items-center gap-2 border-b border-lime pb-1 text-xs font-bold tracking-[0.13em] text-cloud uppercase transition-colors hover:text-lime"
    >
      {footerLabel}
    </a>
  </p>
</div>

{
  magicSent ? (
    <script>
      const resend = document.querySelector("[data-magic-resend]");
      if (resend instanceof HTMLButtonElement) {
        const waitMs = Number(resend.dataset.waitMs ?? "0");
        if (waitMs > 0) {
          resend.disabled = true;
          window.setTimeout(() => {
            resend.disabled = false;
          }, waitMs);
        }
      }
    </script>
  ) : null
}
