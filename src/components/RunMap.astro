---
import type { RunRoute } from "../lib/training";

interface Props {
  route: RunRoute;
  height?: string;
}

const { route, height = "10.5rem" } = Astro.props;
const coords = route.type === "polyline" ? route.coords : [];
const hasPolyline = coords.length >= 2;
const coordJson = hasPolyline ? JSON.stringify(coords.map((point) => [point.lat, point.lng])) : "[]";
---

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<div
  class="relative isolate shrink-0 overflow-hidden rounded-2xl border border-white/12 bg-[#0a1213]"
  style={`height: ${height}`}
>
  {
    hasPolyline ? (
      <div class="run-map absolute inset-0" data-run-map data-coords={coordJson} role="img" aria-label="Run route on the map"></div>
    ) : (
      <div class="relative z-10 flex h-full flex-col items-center justify-center gap-2 px-4">
        <svg class="h-10 w-7 text-lime" viewBox="0 0 24 36" fill="none" aria-hidden="true">
          <path
            d="M12 0C5.4 0 0 5.2 0 11.6 0 20.4 12 36 12 36s12-15.6 12-24.4C24 5.2 18.6 0 12 0Z"
            fill="currentColor"
          />
          <circle cx="12" cy="11.5" r="4.4" fill="#05090b" />
        </svg>
        <p class="text-xs font-semibold tracking-wider text-mist uppercase">No route yet</p>
      </div>
    )
  }
</div>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline>
  (() => {
    if (window.__rsRunMaps) return;
    window.__rsRunMaps = true;
    const maps = new WeakMap();

    const mount = (root) => {
      if (!window.L) return;
      root.querySelectorAll("[data-run-map]").forEach((el) => {
        if (!(el instanceof HTMLElement)) return;
        if (el.getClientRects().length === 0) return;
        const existing = maps.get(el);
        if (existing) {
          existing.invalidateSize();
          if (existing._rsBounds) existing.fitBounds(existing._rsBounds, { padding: [18, 18] });
          return;
        }
        let coords = [];
        try {
          coords = JSON.parse(el.dataset.coords || "[]");
        } catch {
          coords = [];
        }
        if (!Array.isArray(coords) || coords.length < 2) return;
        const map = window.L.map(el, { zoomControl: true, attributionControl: true });
        window.L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
          maxZoom: 19,
          attribution: "&copy; OpenStreetMap",
        }).addTo(map);
        const line = window.L.polyline(coords, { color: "#b8f52c", weight: 4, opacity: 0.95 }).addTo(map);
        const start = coords[0];
        const end = coords[coords.length - 1];
        window.L.circleMarker(start, {
          radius: 6,
          color: "#b8f52c",
          weight: 3,
          fillColor: "#05090b",
          fillOpacity: 1,
        }).addTo(map);
        window.L.circleMarker(end, {
          radius: 6,
          color: "#b8f52c",
          weight: 3,
          fillColor: "#b8f52c",
          fillOpacity: 1,
        }).addTo(map);
        const bounds = line.getBounds();
        map._rsBounds = bounds;
        map.fitBounds(bounds, { padding: [18, 18] });
        maps.set(el, map);
        requestAnimationFrame(() => {
          map.invalidateSize();
          map.fitBounds(bounds, { padding: [18, 18] });
        });
      });
    };

    const boot = () => mount(document);
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
    else boot();

    document.addEventListener(
      "toggle",
      (event) => {
        const dialog = event.target;
        if (dialog instanceof HTMLDialogElement && dialog.open) {
          requestAnimationFrame(() => mount(dialog));
        }
      },
      true,
    );
  })();
</script>
