---
import {
  INTERVALS_RECONNECT_LINK_LABEL,
  INTERVALS_RECONNECT_NOTICE,
  INTERVALS_ROW_ID,
} from "../lib/intervals";

interface Props {
  show: boolean;
}

const { show } = Astro.props;
const linkAt = INTERVALS_RECONNECT_NOTICE.indexOf(INTERVALS_RECONNECT_LINK_LABEL);
const before = linkAt >= 0 ? INTERVALS_RECONNECT_NOTICE.slice(0, linkAt) : INTERVALS_RECONNECT_NOTICE;
const after =
  linkAt >= 0 ? INTERVALS_RECONNECT_NOTICE.slice(linkAt + INTERVALS_RECONNECT_LINK_LABEL.length) : "";
---

{
  show ? (
    <p class="mb-4 rounded-2xl border border-white/12 bg-white/[0.03] px-4 py-3 text-xs leading-5 text-mist">
      {before}
      <a href={`/settings#${INTERVALS_ROW_ID}`} class="font-semibold text-lime underline underline-offset-2">
        {INTERVALS_RECONNECT_LINK_LABEL}
      </a>
      {after}
    </p>
  ) : null
}
