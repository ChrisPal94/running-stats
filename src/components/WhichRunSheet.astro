---
import {
  formatIntervalsRunChoiceLabel,
  type IntervalsRunPickerState,
} from "../lib/intervals";

interface Props {
  picker: IntervalsRunPickerState;
}

const { picker } = Astro.props;
const { choice, remaining, skippedNoSession } = picker;
const runs = [...choice.runs].sort((a, b) => a.start_date_local.localeCompare(b.start_date_local));
---

<dialog
  class="app-sheet mx-auto w-full max-w-md border-0 bg-transparent p-0 text-cloud"
  data-which-run-sheet
  data-open="true"
  aria-modal="true"
  aria-labelledby="which-run-title"
>
  <div
    class="flex max-h-[min(92dvh,44rem)] flex-col overflow-hidden rounded-t-[1.75rem] border border-white/12 border-b-0 bg-[#111718] shadow-[0_-18px_50px_rgba(0,0,0,0.45)]"
    data-which-run-panel
  >
    <div
      class="flex cursor-grab touch-none justify-center pt-3 pb-1"
      data-which-run-handle
      aria-hidden="true"
    >
      <span class="h-1 w-10 rounded-full bg-white/20"></span>
    </div>
    <form method="post" class="flex min-h-0 flex-1 flex-col" data-which-run-form>
      <input type="hidden" name="pickerDate" value={choice.date} />
      <input type="hidden" name="pickerSessionId" value={choice.sessionId} />
      <input type="hidden" name="pickerSessionDistanceKm" value={String(choice.sessionDistanceKm)} />
      <input type="hidden" name="pickerRuns" value={JSON.stringify(choice.runs)} />
      <input type="hidden" name="pickerRemaining" value={JSON.stringify(remaining)} />
      <input type="hidden" name="skippedNoSession" value={skippedNoSession ? "1" : "0"} />

      <div class="flex items-center justify-between gap-3 px-5 pt-2">
        <h2
          id="which-run-title"
          class="text-[0.66rem] font-semibold tracking-[0.13em] text-mist uppercase"
        >
          Which run?
        </h2>
        <button
          type="submit"
          name="intent"
          value="intervals-skip-pick"
          formnovalidate
          data-close-which-run
          aria-label="Close"
          class="grid h-8 w-8 place-items-center rounded-full text-mist transition-colors hover:bg-white/8 hover:text-cloud"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3.5 3.5l9 9M12.5 3.5l-9 9"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <fieldset class="flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto px-5 pt-4 pb-4">
        <legend class="sr-only">Choose which run to import</legend>
        {
          runs.map((run) => (
            <label
              class="cursor-pointer rounded-2xl border border-white/12 bg-panel px-4 py-3.5 text-left transition-colors hover:border-lime/50 hover:bg-white/[0.04] has-[:checked]:border-lime has-[:checked]:bg-lime/10"
            >
              <input
                class="sr-only"
                type="radio"
                name="activityId"
                value={run.activityId}
                checked={run.activityId === choice.defaultActivityId}
                required
              />
              <span class="block text-sm font-semibold text-cloud tabular-nums">
                {formatIntervalsRunChoiceLabel(run)}
              </span>
            </label>
          ))
        }
      </fieldset>

      <div class="px-5 pb-5">
        <button
          type="submit"
          name="intent"
          value="intervals-pick-run"
          class="inline-flex w-full items-center justify-center rounded-full bg-lime px-5 py-3 text-xs font-bold text-ink uppercase shadow-[0_8px_28px_rgba(184,245,44,0.2)] transition-[background-color,transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:bg-[#cbff50] hover:shadow-[0_12px_34px_rgba(184,245,44,0.28)]"
        >
          Import
        </button>
      </div>
    </form>
  </div>
</dialog>

<script>
  const sheet = document.querySelector("[data-which-run-sheet]");
  const panel = document.querySelector("[data-which-run-panel]");
  const handle = document.querySelector("[data-which-run-handle]");
  const form = document.querySelector("[data-which-run-form]");

  const skipPick = () => {
    if (!(form instanceof HTMLFormElement)) return;
    form.noValidate = true;
    const intent = document.createElement("input");
    intent.type = "hidden";
    intent.name = "intent";
    intent.value = "intervals-skip-pick";
    form.append(intent);
    form.requestSubmit();
  };

  const openSheet = () => {
    if (!(sheet instanceof HTMLDialogElement)) return;
    if (sheet.open) sheet.close();
    sheet.showModal();
    const selected = sheet.querySelector<HTMLInputElement>("input[name='activityId']:checked");
    selected?.focus();
  };

  const closeSheet = () => {
    if (sheet instanceof HTMLDialogElement && sheet.open) sheet.close();
    if (panel instanceof HTMLElement) panel.style.transform = "";
    skipPick();
  };

  if (sheet instanceof HTMLDialogElement && sheet.dataset.open === "true") {
    openSheet();
  }

  sheet?.addEventListener("click", (event) => {
    if (event.target === sheet) closeSheet();
  });

  sheet?.addEventListener("cancel", (event) => {
    event.preventDefault();
    closeSheet();
  });

  if (handle instanceof HTMLElement && panel instanceof HTMLElement) {
    let startY = 0;
    let dragging = false;

    const onStart = (clientY: number) => {
      dragging = true;
      startY = clientY;
      panel.style.transition = "none";
    };

    const onMove = (clientY: number) => {
      if (!dragging) return;
      const dy = Math.max(0, clientY - startY);
      panel.style.transform = `translateY(${dy}px)`;
    };

    const onEnd = (clientY: number) => {
      if (!dragging) return;
      dragging = false;
      panel.style.transition = "";
      const dy = clientY - startY;
      if (dy > 72) closeSheet();
      else panel.style.transform = "";
    };

    handle.addEventListener(
      "touchstart",
      (event) => {
        const touch = event.changedTouches[0];
        if (touch) onStart(touch.clientY);
      },
      { passive: true },
    );
    handle.addEventListener(
      "touchmove",
      (event) => {
        const touch = event.changedTouches[0];
        if (touch) onMove(touch.clientY);
      },
      { passive: true },
    );
    handle.addEventListener(
      "touchend",
      (event) => {
        const touch = event.changedTouches[0];
        if (touch) onEnd(touch.clientY);
      },
      { passive: true },
    );
  }
</script>
