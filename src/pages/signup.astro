---
export const prerender = false;

import AuthForm from "../components/AuthForm.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { getCurrentUser, signupFromForm } from "../lib/auth";

const existing = await getCurrentUser(Astro.cookies);
if (existing) {
  return Astro.redirect("/today");
}

let error = "";
let email = "";

if (Astro.request.method === "POST") {
  const result = await signupFromForm(Astro.request, Astro.cookies);
  if (result.ok) {
    return Astro.redirect("/onboarding");
  }
  error = result.error;
  email = result.email;
}
---

<PageLayout
  title="Start your plan — Running Stats"
  description="Start your plan with email and password. A training plan that adapts after every run—so you always know what to run next, and why."
  heading="Start your plan"
>
  <p>
    Start your plan with email and password. This account is yours—no Google or Strava
    sign-in.
  </p>
  <AuthForm
    email={email}
    error={error}
    passwordAutocomplete="new-password"
    footerHref="/login"
    footerLabel="Already training? Log in"
  />
</PageLayout>
