---
export const prerender = false;

import AuthForm from "../components/AuthForm.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { postAuthPath } from "../lib/app-session";
import { authOptionsClause } from "../lib/auth-methods";
import { authPageError, getAuthPageUser, signupFromForm } from "../lib/auth";
import { invalidFormResponse, readFormData } from "../lib/safe-form-data";
import { isMagicLinkIntent, requestMagicLink } from "../lib/magic-link";

const existing = await getAuthPageUser(Astro.cookies);
const signedInPath = existing ? await postAuthPath(existing.id) : undefined;
if (signedInPath) {
  return Astro.redirect(signedInPath);
}

let formError = "";
let duplicateAccount = false;
let email = "";
let method: "password" | "link" = Astro.url.searchParams.get("method") === "link" ? "link" : "password";
let magicSent = false;
let resendWaitMs = 0;

if (Astro.request.method === "POST") {
  const formData = await readFormData(Astro.request);
  if (!formData) return invalidFormResponse();
  if (isMagicLinkIntent(formData)) {
    method = "link";
    const result = await requestMagicLink(Astro.request, formData);
    email = result.email;
    if (result.ok) {
      magicSent = true;
      resendWaitMs = result.cooldownRemainingMs;
    } else {
      formError = result.error;
    }
  } else {
    const result = await signupFromForm(Astro.request, Astro.cookies, formData);
    if (result.ok) {
      return Astro.redirect("/onboarding");
    }
    formError = result.error;
    duplicateAccount = result.duplicateAccount === true;
    email = result.email;
  }
}

const error = authPageError(Astro.url, formError);
---

<PageLayout
  title="Start your plan — Stride Lab"
  description={`Start your plan with ${authOptionsClause()}. A training plan that adapts after every run—so you always know what to run next, and why.`}
  heading="Start your plan"
>
  <p>Start your plan with {authOptionsClause()}.</p>
  <AuthForm
    email={email}
    error={error}
    duplicateAccount={duplicateAccount}
    passwordAutocomplete="new-password"
    footerHref="/login"
    footerLabel="Already training? Log in"
    googleFrom="signup"
    method={method}
    magicSent={magicSent}
    resendWaitMs={resendWaitMs}
  />
</PageLayout>
