---
export const prerender = false;

import AuthForm from "../components/AuthForm.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { postAuthPath } from "../lib/app-session";
import { authOptionsClause } from "../lib/auth-methods";
import { authPageError, getAuthPageUser, loginFromForm } from "../lib/auth";
import {
  isMagicLinkIntent,
  magicLinkExpiredToast,
  requestMagicLink,
} from "../lib/magic-link";

const existing = await getAuthPageUser(Astro.cookies);
const signedInPath = existing ? await postAuthPath(existing.id) : undefined;
if (signedInPath) {
  return Astro.redirect(signedInPath);
}

let formError = "";
let email = "";
let method: "password" | "link" = Astro.url.searchParams.get("method") === "link" ? "link" : "password";
let magicSent = false;
let resendWaitMs = 0;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  if (isMagicLinkIntent(formData)) {
    method = "link";
    const result = await requestMagicLink(Astro.request, formData);
    email = result.email;
    if (result.ok) {
      magicSent = true;
      resendWaitMs = result.cooldownRemainingMs;
    } else {
      formError = result.error;
    }
  } else {
    const result = await loginFromForm(Astro.request, Astro.cookies, formData);
    const destination = result.ok ? await postAuthPath(result.user.id) : undefined;
    if (destination) {
      return Astro.redirect(destination);
    }
    if (!result.ok) {
      formError = result.error;
      email = result.email;
    }
  }
}

const error = authPageError(Astro.url, formError);
const expiredToast = magicLinkExpiredToast(Astro.url);
const signedOutNotice =
  Astro.url.searchParams.get("signedOut") === "1" ? "You’re signed out on all your devices." : "";
---

<PageLayout
  title="Welcome back — Stride Lab"
  description="Welcome back. Sign in to continue today's run."
  heading="Welcome back"
>
  {
    signedOutNotice ? (
      <p role="status" class="text-cloud">
        {signedOutNotice}
      </p>
    ) : null
  }
  <p>Welcome back. Sign in with {authOptionsClause()}.</p>
  <AuthForm
    email={email}
    error={error}
    passwordAutocomplete="current-password"
    footerHref="/signup"
    footerLabel="New here? Start your plan"
    googleFrom="login"
    method={method}
    magicSent={magicSent}
    resendWaitMs={resendWaitMs}
  />
</PageLayout>

{
  expiredToast ? (
    <p
      class="saved-toast pointer-events-none fixed inset-x-0 bottom-8 z-50 mx-auto w-max max-w-[min(100%-2rem,28rem)] rounded-full bg-lime px-4 py-2 text-center text-xs font-bold text-ink shadow-[0_8px_28px_rgba(184,245,44,0.2)]"
      data-magic-toast
      role="status"
    >
      {expiredToast}
    </p>
  ) : null
}

{
  expiredToast ? (
    <script>
      const toast = document.querySelector("[data-magic-toast]");
      window.setTimeout(() => {
        if (toast instanceof HTMLElement) toast.hidden = true;
        if (window.location.search.includes("toast=")) {
          history.replaceState({}, "", "/login");
        }
      }, 1800);
    </script>
  ) : null
}
