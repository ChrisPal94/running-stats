---
export const prerender = false;

import OnboardingWizard from "../components/OnboardingWizard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { getCurrentUser, isSameOrigin } from "../lib/auth";
import {
  getOnboarding,
  getPlanForUser,
  handleOnboardingPost,
  onboardingStep,
  type OnboardingStep,
} from "../lib/training";

const user = await getCurrentUser(Astro.cookies);
if (!user) {
  return Astro.redirect("/signup");
}

const existingPlan = await getPlanForUser(user.id);
if (existingPlan && Astro.request.method !== "POST") {
  return Astro.redirect("/today");
}

let error = "";
let step: OnboardingStep = 1;

if (Astro.request.method === "POST") {
  if (!isSameOrigin(Astro.request)) {
    error = "This request could not be verified. Try again.";
    const draft = await getOnboarding(user.id);
    const requested = Number(Astro.url.searchParams.get("step"));
    step = onboardingStep(draft, Number.isFinite(requested) ? requested : null);
  } else {
    const result = await handleOnboardingPost(user.id, await Astro.request.formData());
    if (result.ok) {
      return Astro.redirect(result.redirect);
    }
    error = result.error;
    step = result.step;
  }
} else {
  const draft = await getOnboarding(user.id);
  const requested = Number(Astro.url.searchParams.get("step"));
  step = onboardingStep(draft, Number.isFinite(requested) ? requested : null);
}

const draft = await getOnboarding(user.id);

const titles = {
  1: "Your goal",
  2: "Your level",
  3: "Your baseline",
  4: "Your days",
  5: "How often should we adapt?",
} as const;
---

<BaseLayout
  title={`${titles[step]} — Running Stats`}
  description="Set up your adaptive training plan in five steps."
>
  <div class="relative isolate min-h-svh bg-ink">
    <Header />
    <main class="mx-auto w-full max-w-3xl px-5 pb-16 pt-4 sm:px-8 sm:pt-6 lg:px-12">
      <OnboardingWizard step={step} error={error} draft={draft} />
    </main>
  </div>
</BaseLayout>
