---
export const prerender = false;

import TodayCard from "../components/TodayCard.astro";
import AppShell from "../layouts/AppShell.astro";
import { isSameOrigin } from "../lib/public-origin";
import { requireAppSession } from "../lib/app-session";
import {
  getAdaptationEventForToday,
  getFeedbackForDate,
  getFeedbackForSession,
  getNextSessionAfterToday,
  getPlanForUser,
  getRunLogForSession,
  getSessionForToday,
  cooperPendingHint,
  formatNextRunHint,
  handleTodayPost,
  type RunLogFormDraft,
} from "../lib/training";

const gate = await requireAppSession(Astro.cookies);
if (!gate.ok) {
  return Astro.redirect(gate.redirect);
}

const { user } = gate;

let logError = "";
let logOpen = false;
let logDraft: RunLogFormDraft | null = null;

if (Astro.request.method === "POST") {
  if (isSameOrigin(Astro.request)) {
    const result = await handleTodayPost(user.id, await Astro.request.formData());
    if (result.ok) {
      return Astro.redirect(result.redirect);
    }
    logError = result.error;
    logOpen = result.logOpen;
    logDraft = result.draft;
  } else {
    return Astro.redirect("/today");
  }
}

const session = await getSessionForToday(user.id);
const plan = await getPlanForUser(user.id);
const cooperHint = cooperPendingHint(plan?.baseline);
const upcoming = session ? null : await getNextSessionAfterToday(user.id);
const nextRunHint = upcoming ? formatNextRunHint(upcoming.date) : null;
const feedback = session ? await getFeedbackForSession(user.id, session.id) : null;
const runLog = session ? await getRunLogForSession(user.id, session.id) : null;
const adaptationEvent = await getAdaptationEventForToday(user.id);
const sourceFeedback = adaptationEvent?.sourceDate
  ? await getFeedbackForDate(user.id, adaptationEvent.sourceDate)
  : null;
const savedToast = Astro.url.searchParams.get("saved") === "1";
const planReady = Astro.url.searchParams.get("ready") === "1";
const readyCopy = planReady ? (nextRunHint ? `Your plan is ready. ${nextRunHint}.` : "Your plan is ready.") : null;
---

<AppShell
  title="Today — Running Stats"
  description="Today’s session from your plan."
  current="today"
  email={user.email}
>
  {readyCopy && (
    <p class="mb-4 rounded-2xl border border-lime/30 bg-lime/8 px-4 py-3 text-xs leading-5 text-[#d6ded6]">
      {readyCopy}
    </p>
  )}
  {cooperHint && (
    <p class="mb-4 rounded-2xl border border-lime/30 bg-lime/8 px-4 py-3 text-xs leading-5 text-[#d6ded6]">
      {cooperHint}{" "}
      <a href="/settings" class="font-semibold text-lime underline underline-offset-2">Settings</a>
    </p>
  )}
  <TodayCard
    session={session}
    nextRunHint={nextRunHint}
    feedback={feedback}
    runLog={runLog}
    adaptationEvent={adaptationEvent}
    sourceFeedbackKind={sourceFeedback?.kind ?? null}
    logOpen={logOpen}
    logError={logError}
    logDraft={logDraft}
    savedToast={savedToast}
  />
</AppShell>
