---
export const prerender = false;

import TodayCard from "../components/TodayCard.astro";
import AppShell from "../layouts/AppShell.astro";
import { isSameOrigin } from "../lib/auth";
import { requireAppSession } from "../lib/app-session";
import { getSessionForToday, handleTodayPost } from "../lib/training";

const gate = await requireAppSession(Astro.cookies);
if (!gate.ok) {
  return Astro.redirect(gate.redirect);
}

const { user } = gate;

if (Astro.request.method === "POST") {
  if (isSameOrigin(Astro.request)) {
    const result = await handleTodayPost(user.id, await Astro.request.formData());
    return Astro.redirect(result.redirect);
  }
  return Astro.redirect("/today");
}

const session = await getSessionForToday(user.id);
const notedFeelingOff = Astro.url.searchParams.get("noted") === "feeling-off";
---

<AppShell
  title="Today — Running Stats"
  description="Today’s session from your plan."
  current="today"
  email={user.email}
>
  <TodayCard session={session} notedFeelingOff={notedFeelingOff} />
</AppShell>
