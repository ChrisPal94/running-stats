---
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Product from "../components/Product.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main>
    <Hero />
    <Product />
    <HowItWorks />
  </main>
</BaseLayout>

<script>
  // Landing arrival: markup never hides content. Add `land-pending` only when
  // we can guarantee it comes back (IntersectionObserver exists and the user
  // has not asked for reduced motion), then swap in `land-in` on first
  // intersect and stop watching. Without JS, content stays fully visible.
  const landTargets = document.querySelectorAll("[data-land]");
  const prefersReducedMotion =
    typeof window.matchMedia === "function" &&
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if ("IntersectionObserver" in window && !prefersReducedMotion) {
    const landObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("land-in");
          entry.target.classList.remove("land-pending");
          landObserver.unobserve(entry.target);
        }
      },
      { threshold: 0.12 },
    );

    for (const target of landTargets) {
      target.classList.add("land-pending");
      landObserver.observe(target);
    }
  }
</script>
